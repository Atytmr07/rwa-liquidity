# Copy this file to `.env` and fill in your own keys. `.env` is gitignored.
#
# None of these are required to run the package in demo mode:
#
#     uv run rwa-liquidity report --demo
#
# ---------------------------------------------------------------------------
# rwa.xyz -- asset metadata, issuers, networks, market values, holder counts.
# Access is gated; request a key from https://rwa.xyz
# ---------------------------------------------------------------------------
RWA_XYZ_API_KEY=

# ---------------------------------------------------------------------------
# Dune Analytics -- transfer-level and holder-level on-chain data.
# Create a key at https://dune.com/settings/api
# The query IDs below point at saved Dune queries the package executes. There
# is no shipped default: a saved query is a resource on your own Dune account,
# so you write and save the two queries yourself. See docs/data-sources.md for
# the exact SQL and the required output columns for each.
# ---------------------------------------------------------------------------
DUNE_API_KEY=
DUNE_TRANSFERS_QUERY_ID=
DUNE_HOLDERS_QUERY_ID=

# ---------------------------------------------------------------------------
# DeFiLlama -- public, no key required. Base URL is overridable only for
# testing against a local mock server.
# ---------------------------------------------------------------------------
# DEFILLAMA_BASE_URL=https://api.llama.fi

# ---------------------------------------------------------------------------
# Cache location. Defaults to `.rwa-cache/` in the current working directory.
# ---------------------------------------------------------------------------
# RWA_LIQUIDITY_CACHE_DIR=.rwa-cache

# ---------------------------------------------------------------------------
# Ethereum JSON-RPC -- public, no key required. This is the source behind the
# published findings. The default endpoint is one of the few public nodes that
# actually serves eth_getLogs; see docs/data-sources.md for the ones that do not.
# ---------------------------------------------------------------------------
# EVM_RPC_URL=https://rpc.mevblocker.io
